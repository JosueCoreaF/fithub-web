    {
      "name": "Setup",
      "item": [
        {
          "name": "GET Bootstrap Operativo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload.sedes?.[0]) pm.collectionVariables.set('sedeId', payload.sedes[0].id);",
                  "if (payload.entrenadores?.[0]) pm.collectionVariables.set('trainerId', payload.entrenadores[0].id);",
                  "if (payload.clientes?.[0]) pm.collectionVariables.set('clienteId', payload.clientes[0].id);",
                  "if (payload.membresias?.[0]) pm.collectionVariables.set('membresiaId', payload.membresias[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bootstrap",
              "host": ["{{baseUrl}}"],
              "path": ["bootstrap"]
            }
          }
        }
      ]
    },
